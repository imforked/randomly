// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model RoomConfig {
  id               String   @id @default(uuid())
  topic            String
  size             Int
  optionsPerGuest  Int
  expiresAt        DateTime
  selectedOptionId String?  @unique

  users          User[]
  options        Option[]
  selectedOption Option?  @relation("RoomSelectedOption", fields: [selectedOptionId], references: [id], onDelete: SetNull)
}

model User {
  id     String     @id @default(uuid())
  name   String
  roomId String
  room   RoomConfig @relation(fields: [roomId], references: [id], onDelete: Cascade)

  options Option[]

  createdAt DateTime @default(now())
}

model Option {
  id     String     @id @default(uuid())
  value  String
  roomId String
  room   RoomConfig @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId String
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  selectedForRoom RoomConfig? @relation("RoomSelectedOption")

  createdAt DateTime @default(now())
}